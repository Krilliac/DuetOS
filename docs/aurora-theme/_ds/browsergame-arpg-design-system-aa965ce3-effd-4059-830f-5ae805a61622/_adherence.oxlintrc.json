{
  "plugins": [
    "react",
    "import"
  ],
  "rules": {
    "react/forbid-elements": [
      "warn",
      {
        "forbid": []
      }
    ],
    "no-restricted-imports": [
      "warn",
      {
        "patterns": [
          {
            "group": [
              "components/core/**",
              "components/hud/**",
              "components/loot/**",
              "tools/assetgen/**",
              "ui_kits/gloomwood-hud/**"
            ],
            "message": "Import design-system components from 'index.js', not component internals."
          }
        ]
      }
    ],
    "no-restricted-syntax": [
      "warn",
      {
        "selector": "Literal[value=/#[0-9a-fA-F]{3,8}\\b/]",
        "message": "Raw hex color — use a design-system color token via var()."
      },
      {
        "selector": "Literal[value=/\\b\\d+px\\b/]",
        "message": "Raw px value — use a design-system spacing token via var()."
      },
      {
        "selector": "Literal[value=/font-family\\s*:\\s*(?!['\\\"]?(?:Cinzel|Spectral))/i]",
        "message": "Font not provided by the design system. Available: Cinzel, Spectral."
      },
      {
        "selector": "JSXOpeningElement[name.name='AbilitySlot'] > JSXAttribute > JSXIdentifier[name!=/^(?:src|children|hotkey|size|cooldown|cooldownText|ready|disabled|onClick|style|key|ref|className|style|children)$/]",
        "message": "<AbilitySlot> doesn't accept that prop. Declared props: src, children, hotkey, size, cooldown, cooldownText, ready, disabled, onClick, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Badge'] > JSXAttribute > JSXIdentifier[name!=/^(?:tone|rarity|outline|children|key|ref|className|style|children)$/]",
        "message": "<Badge> doesn't accept that prop. Declared props: tone, rarity, outline, children."
      },
      {
        "selector": "JSXOpeningElement[name.name='Badge'] > JSXAttribute[name.name='tone'] > Literal[value!=/^(?:gold|neutral|danger|ok)$/]",
        "message": "<Badge> tone must be one of 'gold' | 'neutral' | 'danger' | 'ok'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute > JSXIdentifier[name!=/^(?:variant|size|block|iconLeft|disabled|children|key|ref|className|style|children)$/]",
        "message": "<Button> doesn't accept that prop. Declared props: variant, size, block, iconLeft, disabled, children."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute[name.name='variant'] > Literal[value!=/^(?:primary|secondary|ghost|danger)$/]",
        "message": "<Button> variant must be one of 'primary' | 'secondary' | 'ghost' | 'danger'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute[name.name='size'] > Literal[value!=/^(?:sm|md|lg)$/]",
        "message": "<Button> size must be one of 'sm' | 'md' | 'lg'."
      },
      {
        "selector": "JSXOpeningElement[name.name='IconSlot'] > JSXAttribute > JSXIdentifier[name!=/^(?:src|alt|children|rarity|size|count|hotkey|empty|selected|onClick|key|ref|className|style|children)$/]",
        "message": "<IconSlot> doesn't accept that prop. Declared props: src, alt, children, rarity, size, count, hotkey, empty, selected, onClick."
      },
      {
        "selector": "JSXOpeningElement[name.name='TooltipStat'] > JSXAttribute > JSXIdentifier[name!=/^(?:label|value|key|ref|className|style|children)$/]",
        "message": "<TooltipStat> doesn't accept that prop. Declared props: label, value."
      },
      {
        "selector": "JSXOpeningElement[name.name='Nameplate'] > JSXAttribute > JSXIdentifier[name!=/^(?:name|tier|level|hp|maxHp|style|key|ref|className|style|children)$/]",
        "message": "<Nameplate> doesn't accept that prop. Declared props: name, tier, level, hp, maxHp, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Nameplate'] > JSXAttribute[name.name='tier'] > Literal[value!=/^(?:normal|elite|champion|boss)$/]",
        "message": "<Nameplate> tier must be one of 'normal' | 'elite' | 'champion' | 'boss'."
      },
      {
        "selector": "JSXOpeningElement[name.name='OrbGauge'] > JSXAttribute > JSXIdentifier[name!=/^(?:type|value|max|size|showValue|style|key|ref|className|style|children)$/]",
        "message": "<OrbGauge> doesn't accept that prop. Declared props: type, value, max, size, showValue, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='OrbGauge'] > JSXAttribute[name.name='type'] > Literal[value!=/^(?:health|mana)$/]",
        "message": "<OrbGauge> type must be one of 'health' | 'mana'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Panel'] > JSXAttribute > JSXIdentifier[name!=/^(?:title|subtitle|onClose|footer|width|children|key|ref|className|style|children)$/]",
        "message": "<Panel> doesn't accept that prop. Declared props: title, subtitle, onClose, footer, width, children."
      },
      {
        "selector": "JSXOpeningElement[name.name='RarityName'] > JSXAttribute > JSXIdentifier[name!=/^(?:rarity|size|glow|children|key|ref|className|style|children)$/]",
        "message": "<RarityName> doesn't accept that prop. Declared props: rarity, size, glow, children."
      },
      {
        "selector": "JSXOpeningElement[name.name='RarityName'] > JSXAttribute[name.name='size'] > Literal[value!=/^(?:sm|base|lg)$/]",
        "message": "<RarityName> size must be one of 'sm' | 'base' | 'lg'."
      },
      {
        "selector": "JSXOpeningElement[name.name='ResourceBar'] > JSXAttribute > JSXIdentifier[name!=/^(?:kind|value|max|label|showValue|height|style|key|ref|className|style|children)$/]",
        "message": "<ResourceBar> doesn't accept that prop. Declared props: kind, value, max, label, showValue, height, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='ResourceBar'] > JSXAttribute[name.name='kind'] > Literal[value!=/^(?:health|mana|xp|essence)$/]",
        "message": "<ResourceBar> kind must be one of 'health' | 'mana' | 'xp' | 'essence'."
      }
    ]
  },
  "overrides": [
    {
      "files": [
        "**/index.js"
      ],
      "rules": {
        "no-restricted-imports": "off"
      }
    }
  ],
