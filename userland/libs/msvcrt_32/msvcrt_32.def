; msvcrt_32.def — exported symbols for the i386 msvcrt.dll companion.
LIBRARY msvcrt.dll

EXPORTS
    memcpy
    memmove
    memset
    memcmp
    strlen
    strcmp
    strncmp
    strcpy
    strncpy
    strcat
    strchr
    strrchr
    strstr
    _stricmp
    _strnicmp
    _errno
    _amsg_exit
    _assert
    exit
    _exit
    abort
    _initterm
    _initterm_e
    __set_app_type
    __setusermatherr
    _iob DATA
    __p__commode
    __p__fmode
    __p__acmdln
    __getmainargs
    __initenv
    fopen
    fclose
    fread
    fwrite
    fputs
    fflush
    feof
    ferror
    malloc
    calloc
    free
    realloc
    puts
    atoi
    atol
    _chkstk
    __chkstk
    _alloca_probe

; --- CRT startup cluster (msvcrt_32_crt.c) -------------------------
; The symbols an MSVC-built PE32 touches between its entry point and
; main(). ?terminate@@YAXXZ is renamed onto an ordinary C identifier
; because no C name can spell the MSVC C++ mangling.
    _lock
    _unlock
    _onexit
    atexit
    __dllonexit
    _cexit
    _c_exit
    ?terminate@@YAXXZ = msvcrt32_cxx_terminate
    _purecall
    _callnewh
    _XcptFilter
    _except_handler4_common
    _controlfp
    __wgetmainargs
    _wcmdln DATA

; --- Wide strings / safe memory / wide formatting (msvcrt_32_wide.c)
    wcslen
    wcschr
    wcsrchr
    _wcsicmp
    _wcsnicmp
    _ismbblead
    memcpy_s
    memmove_s
    __iob_func
    _vsnwprintf
